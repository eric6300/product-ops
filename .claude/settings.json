{
  "permissions": {
    "deny": [
      "Edit(repos/**)",
      "Write(repos/**)",
      "NotebookEdit(repos/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-repos.sh"
          }
        ]
      }
    ]
  }
}
